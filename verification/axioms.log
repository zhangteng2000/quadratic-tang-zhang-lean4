QuadraticTangZhang.powers_ge_two (p : Polynomial ℂ) (hdeg : 2 ≤ p.natDegree)
  (hroots : QuadraticTangZhang.RootsInClosedDisk p) {a : ℂ} (hpa : Polynomial.eval a p = 0) {ell : ℝ} (hell : 2 ≤ ell) :
  ↑(p.natDegree - 1) ≤ QuadraticTangZhang.criticalPowerEnergy p a ell ∧
    (QuadraticTangZhang.criticalPowerEnergy p a ell = ↑(p.natDegree - 1) ↔ QuadraticTangZhang.Extremal p)
